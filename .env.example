# Copy this file to .env for local development (never commit the real .env).
# In production (Render), set these as actual Environment Variables in the
# dashboard instead - do not put real secrets in any file committed to git.

# A long random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
STUDY_APP_SECRET=replace-with-a-long-random-secret

# Leave unset to use local SQLite (data/study_system.db).
# In production, Render provides this automatically when you attach a
# PostgreSQL database to the web service - you do not need to set it by hand.
# Format: postgresql://user:password@host:port/dbname
# DATABASE_URL=
